# Copy to .env (production) or .env.dev (local) and fill in.
#
# Everything under "Required" must be set. Everything under "Optional" already
# has a working default in code and only needs setting to override it.
#
# VITE_-prefixed values are BAKED INTO THE FRONTEND BUNDLE at build time and can
# be read by anyone who loads the page. Only publishable keys belong there.
# Never give a secret a VITE_ prefix.

# ─── Required: web ──────────────────────────────────────────────────────────

# Comma-separated allowed CORS origins. Falls back to the production domains
# plus localhost dev ports when unset (see api/app.py).
CORS_ORIGINS=https://syntextai.com,https://www.syntextai.com

# Base URL of the frontend, used to build invite links in emails. Falls back to
# the first CORS_ORIGINS entry. Set this to http://localhost:3000 locally, or
# invite links sent while testing will point at production.
APP_URL=https://syntextai.com

# ─── Required: database ─────────────────────────────────────────────────────

DATABASE_NAME=syntextai
DATABASE_USER=dbuser
DATABASE_PASSWORD=xxxx
DATABASE_HOST=db.example.com
DATABASE_PORT=25060
DATABASE_SSLMODE=require
DATABASE_SSLROOTCERT=certs/ca-certificate.crt

# ─── Required: Stripe ───────────────────────────────────────────────────────

STRIPE_SECRET=sk_test_xxxx
STRIPE_ENDPOINT_SECRET=whsec_xxxx
# Publishable key. Shipped to the browser by design.
VITE_STRIPE_API_KEY=pk_test_xxxx

# One graduated tiered price per plan, created in Stripe to match
# api/core/plans.py: Starter is a flat $99 covering 10 seats then $9 each,
# Business a flat $249 covering 30 then $7 each. A Stripe price is immutable,
# so changing an amount means creating a new price and repointing these.
STRIPE_PRICE_ID_STARTER=price_xxxx
STRIPE_PRICE_ID_BUSINESS=price_xxxx

# ─── Required: Firebase ─────────────────────────────────────────────────────

# Client config. Public by design: access is controlled by security rules and
# by the backend verifying the ID token, not by hiding these.
VITE_FIREBASE_API_KEY=xxxx
VITE_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=example
VITE_FIREBASE_STORAGE_BUCKET=example.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456
VITE_FIREBASE_APP_ID=1:123456:web:abcdef

# Admin credentials, used to verify ID tokens and to sign document URLs.
# Normally supplied as api/config/credentials.json instead; set these only when
# mounting that file is not an option. FIREBASE_PRIVATE_KEY keeps its literal
# \n escapes.
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=
# FIREBASE_AUTH_URI=
# FIREBASE_TOKEN_URI=
# FIREBASE_AUTH_PROVIDER_CERT_URL=
# FIREBASE_CLIENT_CERT_URL=

# ─── Required: models ───────────────────────────────────────────────────────

# Chat completions, OpenAI-compatible.
INFERENCE_BASE_URL=https://inference.example.ai
MODEL_CHAT_ID=openai-gpt-oss-20b
MODEL_ACCESS_KEY=xxxx

# Embeddings.
DO_EMBEDDINGS_URL=https://api.voyageai.com/v1
MODEL_EMBEDDING_ID=voyage-3.5-lite
EMBEDDING_API_KEY=pa-xxxx

# ─── Required: email ────────────────────────────────────────────────────────

SENDGRID_API_KEY=SG.xxxx
# Must be a verified sender or a verified domain in SendGrid, or every send is
# refused and invites go out as links you have to pass on by hand.
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# Verification key for the SendGrid Event Webhook (Settings > Mail Settings >
# Signed Event Webhook). POST /api/sendgrid/events is public, so without this
# anyone who finds the URL can post plausible-looking delivery events and
# pollute the logs. Set it and forged posts are refused.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# ─── Analytics ──────────────────────────────────────────────────────────────

POST_HOG_API_KEY=phc_xxxx
VITE_POST_HOG_API_KEY=phc_xxxx

# ─── Optional: worker ───────────────────────────────────────────────────────
# Concurrency and lease settings for the background job runner. The defaults in
# api/workers/worker.py are tuned for a single small instance.

# API_BASE_URL=http://localhost:3000   # where the worker posts results back
# QUERY_CONCURRENCY=4                  # questions answered in parallel
# INGEST_CONCURRENCY=2                 # documents ingested in parallel
# MAX_INFLIGHT=6                       # ceiling across both
# MAX_RUNS_PER_USER=3                  # stops one tenant starving the rest
# HEAVY_FILE_BYTES=20971520            # above this, ingestion serialises
# LEASE_MINUTES=15                     # before a stalled run is reclaimed
# POLL_INTERVAL=2
# RECLAIM_INTERVAL=60
# WORKER_ID=worker-1
# WORKER_HEARTBEAT_PATH=/tmp/worker.heartbeat

# ─── Optional: database pool ────────────────────────────────────────────────

# DATABASE_URL=                        # overrides the DATABASE_* parts above
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true
# DB_CONNECT_TIMEOUT=30
# DB_CONNECTION_RETRIES=3
# DB_RETRY_DELAY=1
# DB_MAX_RETRY_DELAY=30
# SQL_ECHO=false                       # logs every statement; very noisy

# ─── Optional: retrieval ────────────────────────────────────────────────────

# MAX_TOKENS_CONTEXT=8000              # context budget per answer

# ─── Notifications (Redis) ──────────────────────────────────────────────────
#
# How the API tells the worker there is work, and how the worker tells the API
# to update somebody's browser. Notifications only: the queue itself stays in
# Postgres, so losing Redis costs latency, never jobs.
#
# Leave REDIS_URL empty and both sides fall back to what they did before: the
# worker finds work by polling every POLL_INTERVAL seconds, and notifications
# go over HTTP. Nothing breaks, everything is just slower to start.
# docker-compose sets this to redis://redis:6379/0.

# REDIS_URL=redis://localhost:6379/0

# Proves a call to /api/v1/internal/notify-client really came from the worker.
# That endpoint is the fallback used only when a Redis publish fails, and it
# accepts a user id plus arbitrary event data, so without this anybody who can
# reach the API could push messages into a signed-in customer's browser.
#
# REQUIRED on both the API and the worker, with the same value. Unset means the
# endpoint refuses every call, which loses fallback notifications during a
# Redis outage. Generate one with: openssl rand -hex 32

# INTERNAL_API_SECRET=

# ─── Slack surface ──────────────────────────────────────────────────────────
#
# Answering questions from inside Slack. Unset means the endpoint refuses every
# request, which is the correct default: this is a public URL that answers with
# the contents of private documents.
#
# From the Slack app's Basic Information page.

# SLACK_SIGNING_SECRET=
