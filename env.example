# Copy to .env (production) or .env.dev (local) and fill in.
#
# Everything here is required unless marked otherwise. Tuning knobs are NOT
# listed: they all have working defaults, and the reason behind each value lives
# next to it in the code, where it cannot drift out of step with the default it
# is describing. Look in api/workers/worker.py (concurrency, leases),
# api/services/llm_service.py (vision dpi, deadlines, token budgets) and
# api/models/async_db.py (connection pool).
#
# VITE_-prefixed values are BAKED INTO THE FRONTEND BUNDLE at build time and can
# be read by anyone who loads the page. Only publishable keys belong there.
# Never give a secret a VITE_ prefix.

# ─── Web ────────────────────────────────────────────────────────────────────

CORS_ORIGINS=https://syntextai.com,https://www.syntextai.com
# Used to build invite links. Set it locally, or links sent while testing point
# at production.
APP_URL=https://syntextai.com

# ─── Database ───────────────────────────────────────────────────────────────

DATABASE_NAME=syntextai
DATABASE_USER=dbuser
DATABASE_PASSWORD=xxxx
DATABASE_HOST=db.example.com
DATABASE_PORT=25060
DATABASE_SSLMODE=require
DATABASE_SSLROOTCERT=certs/ca-certificate.crt
# DATABASE_URL=                        # overrides the parts above

# ─── Stripe ─────────────────────────────────────────────────────────────────

STRIPE_SECRET=sk_test_xxxx
STRIPE_ENDPOINT_SECRET=whsec_xxxx
VITE_STRIPE_API_KEY=pk_test_xxxx

# One graduated tiered price per plan, matching api/core/plans.py. A Stripe
# price is immutable, so changing an amount means creating a new price and
# repointing these.
STRIPE_PRICE_ID_STARTER=price_xxxx
STRIPE_PRICE_ID_BUSINESS=price_xxxx

# ─── Firebase ───────────────────────────────────────────────────────────────

# Public by design: access comes from security rules and from the backend
# verifying the ID token, not from hiding these.
VITE_FIREBASE_API_KEY=xxxx
VITE_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=example
VITE_FIREBASE_STORAGE_BUCKET=example.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456
VITE_FIREBASE_APP_ID=1:123456:web:abcdef

# Admin credentials, for verifying ID tokens and signing document URLs.
# Normally supplied as api/config/credentials.json; use these only when mounting
# that file is not an option, and then set ALL of them — the code reads each one
# and a partial set produces a confusing certificate error rather than a missing
# value. FIREBASE_PRIVATE_KEY keeps its literal \n escapes.
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=
# FIREBASE_AUTH_URI=
# FIREBASE_TOKEN_URI=
# FIREBASE_AUTH_PROVIDER_CERT_URL=
# FIREBASE_CLIENT_CERT_URL=

# ─── Models ─────────────────────────────────────────────────────────────────

# Chat, vision and embeddings all on DeepInfra. ONE key, set once:
# EMBEDDING_API_KEY and VISION_API_KEY both fall back to MODEL_ACCESS_KEY, so
# they only need setting to point a model at a different provider.
#
# Model ids are namespaced with a slash and matched exactly: a stray space or a
# missing prefix returns "model not found", which reads like the model is
# unavailable rather than like a typo.
INFERENCE_BASE_URL=https://api.deepinfra.com/v1/openai
MODEL_ACCESS_KEY=xxxx
MODEL_CHAT_ID=openai/gpt-oss-20b
MODEL_VISION_ID=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8

# CHANGING MODEL_EMBEDDING_ID INVALIDATES EVERY STORED VECTOR. An embedding is a
# set of coordinates and a different model is a different map: old vectors and
# new queries still compare without error, still rank, and return confident
# citations to arbitrary pages. Documents must be re-uploaded after a change.
# The width must also stay 1024, or the pgvector column needs a migration.
DO_EMBEDDINGS_URL=https://api.deepinfra.com/v1/openai
MODEL_EMBEDDING_ID=Qwen/Qwen3-Embedding-0.6B

# Optional: split a model onto a different provider. Each defaults to the
# matching value above.
# EMBEDDING_API_KEY=
# VISION_BASE_URL=
# VISION_API_KEY=

# ─── Email ──────────────────────────────────────────────────────────────────

SENDGRID_API_KEY=SG.xxxx
# Must be a verified sender or domain, or every send is refused and invites go
# out as links you pass on by hand.
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# POST /api/sendgrid/events is public. Without this, anyone who finds the URL
# can post plausible delivery events.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# ─── Analytics ──────────────────────────────────────────────────────────────

POST_HOG_API_KEY=phc_xxxx
VITE_POST_HOG_API_KEY=phc_xxxx

# ─── Redis, and the secret its fallback needs ───────────────────────────────

# Notifications only; the queue stays in Postgres, so losing Redis costs
# latency, never jobs. Unset means the worker polls instead. docker-compose
# sets this to redis://redis:6379/0.
# REDIS_URL=redis://localhost:6379/0

# Where the worker reaches the API. Only needed when the worker runs somewhere
# the default localhost:3000 does not resolve; docker-compose sets it.
# API_BASE_URL=http://localhost:3000

# REQUIRED on both API and worker, with the SAME value. It proves a call to
# /api/v1/internal/notify-client came from the worker, and that endpoint accepts
# a user id plus arbitrary event data — so without it, anyone who can reach the
# API could push messages into a signed-in customer's browser. Unset means the
# endpoint refuses everything, losing fallback notifications during a Redis
# outage. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ─── Optional surfaces ──────────────────────────────────────────────────────

# Answering from inside Slack. Unset means the endpoint refuses every request,
# which is the right default: it is a public URL that answers with the contents
# of private documents.
# SLACK_SIGNING_SECRET=

# Import from Drive. Both are public by design — they identify the app and
# authorise nothing; access comes from the customer signing in and picking
# files. Needs the Drive API and Picker API enabled, an OAuth client whose
# authorised JavaScript origins include this app's URLs, and an API key
# restricted to the Picker API. Unset and the button does not appear, which is
# right: a button that always fails teaches people the feature is broken.
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=
